// Movie Memory — data model
//
// User / Account / Session / VerificationToken are the standard NextAuth
// tables (required by the Prisma adapter). Our own data is:
//   - User.favoriteMovie   : the one favorite movie (null = not onboarded yet)
//   - Fact                 : every generated fact, append-only history
//   - FactGenerationLock   : short-lived lease that stops duplicate generation

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Null until the user finishes onboarding. Also the signal used to route
  // first-time users to /onboarding and returning users to /dashboard.
  favoriteMovie String?   @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  facts         Fact[]
  factGenLock   FactGenerationLock?
}

model Fact {
  id        String   @id @default(cuid())
  userId    String
  // Snapshot of the movie the fact is about. If the user later changes their
  // favorite movie, old facts no longer match and the cache naturally misses.
  movie     String   @db.VarChar(100)
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Serves the hot query: "latest fact for this user + movie".
  @@index([userId, movie, createdAt(sort: Desc)])
}

// One row per user while (or shortly after) a fact is being generated.
// Acquired atomically with INSERT ... ON CONFLICT ... WHERE lockedUntil < now(),
// so only one request at a time can call OpenAI for a given user. The lease
// expires on its own, so a crashed request can never block a user forever.
model FactGenerationLock {
  userId      String   @id
  token       String
  lockedUntil DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---- NextAuth tables -------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
