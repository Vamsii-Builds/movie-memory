# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movie_memory?schema=public"

# NextAuth — NEXTAUTH_SECRET: generate with `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Fact generation (server-side only — never prefixed with NEXT_PUBLIC_).
# Set ANTHROPIC_API_KEY to use Claude; leave it empty to use OpenAI instead.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
